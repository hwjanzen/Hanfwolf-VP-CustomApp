{%- style -%}
  .rope-configurator-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__inner {
    max-width: 76rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__intro {
    margin-bottom: 2.4rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__variant {
    max-width: 42rem;
    margin-bottom: 2.4rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__cuts {
    display: grid;
    gap: 1.6rem;
  }

  .rope-configurator-{{ section.id }} .rope-cut {
    display: grid;
    grid-template-columns: minmax(10rem, 0.6fr) minmax(14rem, 1fr) minmax(18rem, 1.4fr) auto;
    gap: 1.6rem;
    align-items: end;
    padding: 1.6rem 0;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  .rope-configurator-{{ section.id }} .rope-cut__field,
  .rope-configurator-{{ section.id }} .rope-cut__presentation {
    display: grid;
    gap: 0.8rem;
  }

  .rope-configurator-{{ section.id }} .rope-cut__field input,
  .rope-configurator-{{ section.id }} .rope-configurator__variant select {
    width: 100%;
    min-height: 4.8rem;
    padding: 0.8rem 1.2rem;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.45);
    border-radius: var(--inputs-radius);
    font: inherit;
  }

  .rope-configurator-{{ section.id }} .rope-cut__options {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    min-height: 4.8rem;
    align-items: center;
  }

  .rope-configurator-{{ section.id }} .rope-cut__option {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
  }

  .rope-configurator-{{ section.id }} .rope-cut__remove {
    min-width: 4.8rem;
    min-height: 4.8rem;
    border: 0;
    background: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    font-size: 2.4rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__error {
    margin-top: 1.6rem;
    color: rgb(var(--color-error));
  }

  .rope-configurator-{{ section.id }} .rope-configurator__notice {
    margin-top: 1.2rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (max-width: 749px) {
    .rope-configurator-{{ section.id }} .rope-cut {
      grid-template-columns: 1fr 1fr;
    }

    .rope-configurator-{{ section.id }} .rope-cut__presentation {
      grid-column: 1 / -1;
    }
  }
{%- endstyle -%}

<section class="rope-configurator-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width rope-configurator__inner">
    <div class="rope-configurator__intro">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.description | escape }}</p>
    </div>

    <form
      id="RopeConfigurator-{{ section.id }}"
      data-rope-configurator
    >
      {% comment %}       
       <div class="rope-configurator__variant">
        <label for="RopeVariant-{{ section.id }}">Ausführung</label>
        <select id="RopeVariant-{{ section.id }}" data-rope-variant required>
          {%- for variant in product.variants -%}
            <option
              value="gid://shopify/ProductVariant/{{ variant.id }}"
              {% unless variant.available %}disabled{% endunless %}
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
            >
              {{ variant.title | escape }}{% unless variant.available %} – nicht verfügbar{% endunless %}
            </option>
          {%- endfor -%}
        </select>
      </div> 
      {% endcomment %}

      <div class="rope-configurator__cuts" data-rope-cuts></div>

      <div class="rope-configurator__actions">
        <button class="button button--secondary" type="button" data-add-rope-cut>
          Weiteren Zuschnitt hinzufügen
        </button>
        <button class="button" type="submit" data-rope-submit>
          Zur Kasse
        </button>
      </div>

      <p class="rope-configurator__notice">
        Preis und Versandgewicht werden anhand der gewählten Länge berechnet.
      </p>
      <p class="rope-configurator__error" role="alert" hidden data-rope-error></p>
    </form>
  </div>

  <template data-rope-cut-template>
    <fieldset class="rope-cut">
      <div class="rope-cut__field">
        <label data-quantity-label>Anzahl Seile</label>
        <input type="number" min="1" max="999" step="1" value="1" required data-rope-quantity>
      </div>

      <div class="rope-cut__field">
        <label data-length-label>Länge je Seil (m)</label>
        <input
          type="number"
          inputmode="decimal"
          min="{{ section.settings.minimum_length }}"
          max="{{ section.settings.maximum_length }}"
          step="0.01"
          value="{{ section.settings.default_length }}"
          required
          data-rope-length
        >
      </div>

      <div class="rope-cut__presentation">
        <span>Aufmachung</span>
        <div class="rope-cut__options">
          <label class="rope-cut__option">
            <input type="radio" value="Ring" checked data-rope-presentation>
            Ring
          </label>
          <label class="rope-cut__option">
            <input type="radio" value="Haspel" data-rope-presentation>
            Haspel (Aufpreis)
          </label>
        </div>
      </div>

      <button class="rope-cut__remove" type="button" aria-label="Zuschnitt entfernen" title="Zuschnitt entfernen" data-remove-rope-cut>
        &times;
      </button>
    </fieldset>
  </template>
</section>

<script
  src="/apps/hanfwolf-pricing/script"
  data-proxy-path="/apps/hanfwolf-pricing"
  defer
></script>

<script>
  (() => {
    const form = document.getElementById('RopeConfigurator-{{ section.id }}');
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const section = form.closest('.rope-configurator-{{ section.id }}');
    const cutsContainer = form.querySelector('[data-rope-cuts]');
    const template = section.querySelector('[data-rope-cut-template]');
    const errorElement = form.querySelector('[data-rope-error]');
    const submitButton = form.querySelector('[data-rope-submit]');
    let nextIndex = 0;

    function addCut() {
      const fragment = template.content.cloneNode(true);
      const cut = fragment.querySelector('.rope-cut');
      const index = nextIndex++;
      const quantity = cut.querySelector('[data-rope-quantity]');
      const length = cut.querySelector('[data-rope-length]');
      const radios = cut.querySelectorAll('[data-rope-presentation]');

      quantity.id = `RopeQuantity-{{ section.id }}-${index}`;
      length.id = `RopeLength-{{ section.id }}-${index}`;
      cut.querySelector('[data-quantity-label]').htmlFor = quantity.id;
      cut.querySelector('[data-length-label]').htmlFor = length.id;
      radios.forEach((radio) => {
        radio.name = `rope-presentation-${index}`;
      });

      cut.querySelector('[data-remove-rope-cut]').addEventListener('click', () => {
        cut.remove();
        updateRemoveButtons();
      });

      cutsContainer.appendChild(fragment);
      updateRemoveButtons();
    }

    function updateRemoveButtons() {
      const cuts = cutsContainer.querySelectorAll('.rope-cut');
      cuts.forEach((cut) => {
        cut.querySelector('[data-remove-rope-cut]').hidden = cuts.length === 1;
      });
    }

    function showError(message) {
      errorElement.textContent = message;
      errorElement.hidden = !message;
    }

    form.querySelector('[data-add-rope-cut]').addEventListener('click', addCut);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showError('');
      if (!form.reportValidity()) return;

      const variantId = 'gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}';
      const items = Array.from(cutsContainer.querySelectorAll('.rope-cut')).map((cut) => ({
        variantId,
        quantity: Number(cut.querySelector('[data-rope-quantity]').value),
        lengthMeters: cut.querySelector('[data-rope-length]').value,
        presentation: cut.querySelector('[data-rope-presentation]:checked').value,
      }));

      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');

      try {
        if (!window.HanfwolfPricing?.addRopeCutToCart) {
          throw new Error('Der Hanfwolf-Warenkorbservice wurde nicht geladen.');
        }

        for (const item of items) {
          await window.HanfwolfPricing.addRopeCutToCart(item);
        }

        window.location.assign('{{ routes.cart_url }}');
      } catch (error) {
        showError(error instanceof Error ? error.message : 'Der Zuschnitt konnte nicht in den Warenkorb gelegt werden.');
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
      }
    });

    addCut();
  })();
</script>

{% schema %}
{
  "name": "Seil-Konfigurator",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Seil konfigurieren"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Beschreibung",
      "default": "Lege Anzahl, Länge und Aufmachung für jeden gewünschten Zuschnitt fest."
    },
    {
      "type": "number",
      "id": "minimum_length",
      "label": "Minimale Länge in Metern",
      "default": 0.5
    },
    {
      "type": "number",
      "id": "maximum_length",
      "label": "Maximale Länge in Metern",
      "default": 500
    },
    {
      "type": "number",
      "id": "default_length",
      "label": "Vorgabewert in Metern",
      "default": 1
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Seil-Konfigurator"
    }
  ]
}
{% endschema %}